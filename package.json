{
  "name": "metaontic-video",
  "version": "2.1.5",
  "description": "DeepSeek Harness plugin: generate short videos with Seedance - a single generation up to 15 seconds, or a base clip plus automatically extended segments merged into one file with ffmpeg. Ships the video_generate / video_extend / video_status tools, an in-app settings page, and the built-in \"video director\" agent preset (script-first workflow with human approval). Works through a New API relay.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "seedance",
    "video",
    "video-extension",
    "text-to-video",
    "ffmpeg",
    "new-api",
    "agent-preset",
    "video-director"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxsimon2022/metaontic-video.git"
  },
  "homepage": "https://github.com/wxsimon2022/metaontic-video#readme",
  "bugs": {
    "url": "https://github.com/wxsimon2022/metaontic-video/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "skills",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
