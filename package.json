{
  "name": "metaontic-video",
  "version": "2.9.0",
  "description": "DeepSeek Harness video generation plugin: say what you want and get a finished clip — up to 15 seconds in one shot, longer videos are generated shot by shot and merged seamlessly into a single file with ffmpeg, right on your machine. Extend a clip you already have (forwards or backwards), check/install the ffmpeg it needs, and watch progress by task id. Ships the video_generate / video_extend / video_status / video_setup / video_config tools, an in-app settings page with email login and live quota/usage, and a built-in \"video director\" agent preset (script first, human approval before spending). Works through a New API relay.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "seedance",
    "video",
    "video-extension",
    "text-to-video",
    "ffmpeg",
    "new-api",
    "agent-preset",
    "video-director"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxsimon2022/metaontic-video.git"
  },
  "homepage": "https://github.com/wxsimon2022/metaontic-video#readme",
  "bugs": {
    "url": "https://github.com/wxsimon2022/metaontic-video/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "skills",
    "locale/*.json",
    "icon.svg",
    "logo.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:locale": "esbuild scripts/build-locale.ts --format=esm --platform=node --packages=external --outfile=node_modules/.cache/build-locale.mjs --log-level=warning && node node_modules/.cache/build-locale.mjs",
    "build:host": "esbuild src/index.ts --format=esm --platform=node --target=node20 --packages=external --define:__PLUGIN_VERSION__=$(node -p 'JSON.stringify(require(\"./package.json\").version)') --outfile=index.js",
    "build:client": "esbuild src/client.ts --format=esm --platform=browser --target=es2022 --define:__PLUGIN_VERSION__=$(node -p 'JSON.stringify(require(\"./package.json\").version)') --outfile=client.js",
    "build": "npm run typecheck && npm run build:locale && npm run build:host && npm run build:client"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
