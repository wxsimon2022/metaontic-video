{
  "name": "metaontic-video",
  "version": "2.5.8",
  "description": "DeepSeek Harness plugin: generate videos with Seedance (text-to-video / image-to-video), including videos longer than a single generation — the extra length is generated shot by shot and merged into one file with ffmpeg — plus video_extend for adding footage to a clip you already have, and video_setup to check/install the ffmpeg it needs. Ships the video_generate / video_extend / video_status tools, an in-app settings page, and the built-in \"video director\" agent preset (script-first workflow with human approval). Works through a New API relay.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "seedance",
    "video",
    "video-extension",
    "text-to-video",
    "ffmpeg",
    "new-api",
    "agent-preset",
    "video-director"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxsimon2022/metaontic-video.git"
  },
  "homepage": "https://github.com/wxsimon2022/metaontic-video#readme",
  "bugs": {
    "url": "https://github.com/wxsimon2022/metaontic-video/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "skills",
    "locale/*.json",
    "icon.svg",
    "logo.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:host": "esbuild src/index.ts --format=esm --platform=node --target=node20 --packages=external --outfile=index.js",
    "build:client": "esbuild src/client.ts --format=esm --platform=browser --target=es2022 --outfile=client.js",
    "build": "npm run typecheck && npm run build:host && npm run build:client"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
